<?xml version="1.0" encoding="utf-8"?>
<com.facebook.shimmer.ShimmerFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/native_ad_view"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white">

        <View
            android:id="@+id/icon"
            android:layout_width="@dimen/_44dp"
            android:layout_height="@dimen/_44dp"
            android:layout_marginStart="@dimen/_16dp"
            android:layout_marginTop="@dimen/_14dp"
            android:background="@color/shimmer_bg"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            android:id="@+id/ad_notification_view"
            android:layout_width="@dimen/_22dp"
            android:layout_height="@dimen/_18dp"
            android:layout_marginStart="@dimen/_8dp"
            android:layout_marginTop="@dimen/_14dp"
            android:background="@color/shimmer_bg"
            app:layout_constraintStart_toEndOf="@id/icon"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            android:id="@+id/primary"
            android:layout_width="0dp"
            android:layout_height="@dimen/_18dp"
            android:layout_marginStart="@dimen/_6dp"
            android:layout_marginEnd="@dimen/_16dp"
            android:background="@color/shimmer_bg"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/ad_notification_view"
            app:layout_constraintTop_toTopOf="@id/ad_notification_view" />

        <View
            android:id="@+id/sponsored"
            android:layout_width="@dimen/_64dp"
            android:layout_height="@dimen/_12dp"
            android:layout_marginTop="@dimen/_4dp"
            android:background="@color/shimmer_bg"
            app:layout_constraintStart_toStartOf="@id/ad_notification_view"
            app:layout_constraintTop_toBottomOf="@id/ad_notification_view" />

        <View
            android:id="@+id/media_view"
            android:layout_width="0dp"
            android:layout_height="@dimen/_124dp"
            android:layout_marginStart="@dimen/_16dp"
            android:layout_marginTop="@dimen/_12dp"
            android:layout_marginEnd="@dimen/_16dp"
            android:background="@color/shimmer_bg"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/icon" />

        <View
            android:id="@+id/body"
            android:layout_width="0dp"
            android:layout_height="@dimen/_48dp"
            android:layout_marginStart="@dimen/_16dp"
            android:layout_marginTop="@dimen/_12dp"
            android:layout_marginEnd="@dimen/_8dp"
            android:layout_marginBottom="@dimen/_12dp"
            android:background="@color/shimmer_bg"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/layout_cta"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/media_view" />

        <View
            android:id="@+id/layout_cta"
            android:layout_width="@dimen/_110dp"
            android:layout_height="@dimen/_48dp"
            android:layout_marginEnd="@dimen/_16dp"
            android:background="@color/shimmer_bg"
            app:layout_constraintBottom_toBottomOf="@id/body"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/body" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.facebook.shimmer.ShimmerFrameLayout>
