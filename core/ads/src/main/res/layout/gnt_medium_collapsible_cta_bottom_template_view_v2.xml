<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <com.google.android.gms.ads.nativead.NativeAdView
        android:id="@+id/native_ad_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/core_bg_native_ads">

        <RelativeLayout
            android:id="@+id/background"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="visible"
            android:paddingBottom="@dimen/_14dp">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/ad_notification_view"
                style="@style/AdsNotificationViewStyle"
                android:layout_alignParentLeft="true"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:textSize="@dimen/_8dp"
                android:layout_alignParentTop="true" />


            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/primary"
                style="@style/AdsTitleTextStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/media_view"
                android:gravity="center"
                android:textAlignment="center"
                android:textSize="@dimen/_13dp"
                android:layout_marginStart="@dimen/_14dp"
                android:layout_marginEnd="@dimen/_14dp"
                android:layout_marginTop="@dimen/_7dp"
                tools:text="Test AD : Flood-It!" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/body"
                style="@style/AdsBodyTextStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_below="@+id/primary"
                android:layout_alignStart="@+id/primary"
                android:layout_alignEnd="@+id/primary"
                android:gravity="center"
                android:textAlignment="center"
                android:lines="2"
                android:textSize="@dimen/_11dp"
                tools:text="Install Flood-It App for free! Free Popurlar Casual Game " />

            <com.google.android.gms.ads.nativead.MediaView
                android:id="@+id/media_view"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_156dp"
                android:layout_below="@+id/ad_notification_view"
                android:layout_alignStart="@+id/layout_cta"
                android:layout_alignEnd="@+id/primary"
                android:layout_marginTop="@dimen/_7dp" />

            <FrameLayout
                android:id="@+id/layout_cta"
                style="@style/CtaCardViewStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/body"
                android:layout_marginStart="@dimen/_14dp"
                android:layout_marginTop="@dimen/_10dp"
                android:layout_marginEnd="@dimen/_14dp">

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/cta"
                    style="@style/CtaViewStyle"
                    tools:text="Install" />

            </FrameLayout>
        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/backgroundMini"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:paddingBottom="@dimen/_10dp"
            android:visibility="visible">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/ad_notification_viewMini"
                style="@style/AdsNotificationViewStyle"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:textSize="@dimen/_8dp"
                android:layout_alignParentLeft="true"
                android:layout_alignParentTop="true" />


            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/primaryMini"
                style="@style/AdsTitleTextStyle"
                android:layout_width="match_parent"
                android:gravity="center"
                android:textAlignment="center"
                android:textSize="@dimen/_14dp"
                android:layout_marginHorizontal="@dimen/_20dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_8dp"
                android:layout_alignEnd="@+id/layout_ctaMini"
                tools:text="Test AD : Flood-It!" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/bodyMini"
                style="@style/AdsBodyTextStyle"
                android:layout_width="0dp"
                android:textAlignment="center"
                android:textSize="@dimen/_12dp"
                android:layout_height="wrap_content"
                android:layout_below="@+id/primaryMini"
                android:layout_alignStart="@+id/primaryMini"
                android:layout_alignEnd="@+id/layout_ctaMini"
                android:gravity="center"
                android:lines="2"
                tools:text="Install Flood-It App for free! Free Popurlar Casual Game " />

            <FrameLayout
                android:id="@+id/layout_ctaMini"
                style="@style/CtaCardViewStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/bodyMini"
                android:layout_marginStart="@dimen/_14dp"
                android:layout_marginTop="@dimen/_14dp"
                android:layout_marginEnd="@dimen/_14dp"
                tools:background="@drawable/core_bg_cta_ads">

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/ctaMini"
                    style="@style/CtaViewStyle"
                    android:paddingTop="@dimen/_8dp"
                    android:paddingBottom="@dimen/_9dp"
                    tools:text="Install" />
            </FrameLayout>

        </RelativeLayout>
    </com.google.android.gms.ads.nativead.NativeAdView>

    <androidx.appcompat.widget.AppCompatImageView
        android:layout_width="@dimen/_22dp"
        android:background="@drawable/bg_close_collapsible"
        android:src="@drawable/ic_arrow_down_24px"
        android:tint="@color/black"
        android:elevation="@dimen/_5dp"
        android:id="@+id/icCloseCollapse"
        android:layout_gravity="right"
        android:layout_marginHorizontal="@dimen/_10dp"
        android:layout_marginTop="@dimen/_18dp"
        android:layout_height="@dimen/_22dp"/>
</FrameLayout>
