<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <com.google.android.gms.ads.nativead.NativeAdView
        android:id="@+id/native_ad_view"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_45dp"
        android:background="@drawable/core_bg_native_ads">

        <RelativeLayout
            android:id="@+id/background"
            android:gravity="center_vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">


            <FrameLayout
                android:id="@+id/containerIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignTop="@+id/primary"
                android:layout_alignBottom="@+id/body"
                android:layout_alignParentStart="true"
                android:layout_marginStart="@dimen/_10dp">

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/icon"
                    android:layout_width="@dimen/_36dp"
                    android:layout_height="@dimen/_36dp"
                    android:layout_gravity="center_vertical"
                    android:layout_marginEnd="@dimen/_8dp"
                    android:scaleType="fitCenter"
                    android:visibility="visible" />

            </FrameLayout>

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/primary"
                style="@style/AdsTitleTextStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                android:layout_marginEnd="@dimen/_7dp"
                android:layout_toStartOf="@+id/frameButton"
                android:layout_toEndOf="@+id/ad_notification_view"
                android:fontFamily="@font/inter_regular"
                android:textSize="@dimen/_12dp"
                android:layout_marginStart="@dimen/_5dp"
                android:textStyle="normal"
                tools:text="Test AD : Flood-It!" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/ad_notification_view"
                style="@style/AdsNotificationViewStyle"
                android:background="@drawable/gnt_rounded_shape"
                android:layout_alignTop="@+id/primary"
                android:layout_toEndOf="@+id/containerIcon" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/body"
                style="@style/AdsBodyTextStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_below="@+id/primary"
                android:layout_alignStart="@+id/ad_notification_view"
                android:layout_alignEnd="@+id/primary"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:ellipsize="end"
                android:textSize="@dimen/_10dp"
                tools:text="Install Flood-It App for free! Free Popular Casual Game" />

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_alignTop="@+id/primary"
                android:layout_alignBottom="@+id/body"
                android:id="@+id/frameButton"
                android:layout_marginEnd="@dimen/_14dp"
                android:layout_alignParentEnd="true"
                android:layout_height="wrap_content">
                <FrameLayout
                    android:id="@+id/layout_cta"
                    android:layout_gravity="center"
                    style="@style/CtaCardViewStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/cta"
                        style="@style/CtaRightSmallViewStyle"
                        android:layout_gravity="center_vertical"
                        tools:background="@color/color_cta_banner_native_ads"
                        tools:text="Install" />
                </FrameLayout>
            </FrameLayout>



        </RelativeLayout>

    </com.google.android.gms.ads.nativead.NativeAdView>

</merge>
