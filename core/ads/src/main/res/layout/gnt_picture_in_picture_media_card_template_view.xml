<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="@dimen/_208dp"
    android:layout_height="@dimen/_208dp">

    <FrameLayout
        android:id="@+id/background"
        android:layout_width="@dimen/_208dp"
        android:layout_height="@dimen/_208dp"
        android:background="@drawable/bg_native_picture_in_picture">

        <com.google.android.gms.ads.nativead.NativeAdView
            android:id="@+id/native_ad_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    app:cardCornerRadius="@dimen/_5dp"
                    android:layout_margin="@dimen/_1_5dp"
                    android:layout_height="wrap_content">
                    <com.google.android.gms.ads.nativead.MediaView
                        android:id="@+id/media_view"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_120dp"
                        android:background="@color/black"
                        android:minHeight="@dimen/native_picture_in_picture_media_min_size" />
                </androidx.cardview.widget.CardView>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_42dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/_6dp"
                    android:paddingEnd="@dimen/_6dp">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/icon"
                        android:layout_width="@dimen/_30dp"
                        android:layout_height="@dimen/_30dp"
                        android:layout_marginEnd="@dimen/_4dp"
                        android:scaleType="fitCenter"
                        android:visibility="gone"
                        tools:visibility="visible" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/ad_notification_view"
                        style="@style/AdsNotificationViewStyle"
                        android:layout_marginEnd="@dimen/_4dp"
                        android:background="@drawable/gnt_rounded_corners_shape_round"
                        android:minHeight="0dp"
                        android:paddingTop="@dimen/_2dp"
                        android:paddingBottom="@dimen/_2dp"
                        android:textSize="@dimen/_9dp" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/primary"
                        style="@style/AdsTitleTextStyle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:fontFamily="@font/inter_regular"
                        android:lines="2"
                        android:maxLines="2"
                        android:gravity="center_vertical"
                        android:textSize="@dimen/_12dp"
                        tools:text="ASUS Back To School " />
                </LinearLayout>

                <FrameLayout
                    android:id="@+id/layout_cta"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_40dp"
                    android:layout_marginStart="@dimen/_4dp"
                    android:layout_marginEnd="@dimen/_4dp"
                    android:layout_marginBottom="@dimen/_3dp"
                    android:background="@drawable/bg_native_picture_in_picture_media_card_cta">

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/cta"
                        style="@style/CtaViewStyle"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:textAllCaps="false"
                        android:textSize="@dimen/_16dp"
                        tools:text="MỞ" />
                </FrameLayout>
            </LinearLayout>
        </com.google.android.gms.ads.nativead.NativeAdView>

        <FrameLayout
            android:id="@+id/close_button_container"
            android:layout_width="@dimen/_26dp"
            android:layout_height="@dimen/_26dp"
            android:layout_marginStart="@dimen/_6dp"
            android:layout_marginTop="@dimen/_6dp"
            android:clickable="true"
            android:contentDescription="@android:string/cancel"
            android:focusable="true">

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/action_progress"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:indeterminate="false"
                android:max="1000"
                android:progress="0"
                app:indicatorColor="#6F6F6F"
                app:indicatorInset="0dp"
                app:indicatorSize="@dimen/_26dp"
                app:trackColor="#DADADA"
                app:trackThickness="@dimen/_2dp" />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/close_button"
                android:layout_width="@dimen/_22dp"
                android:layout_height="@dimen/_22dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_native_interstitial_action"
                android:padding="@dimen/_3dp"
                android:src="@drawable/ic_close_ads_v"
                android:tint="@color/white" />
        </FrameLayout>
    </FrameLayout>
</FrameLayout>
