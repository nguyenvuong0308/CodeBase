<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/startflow_language_v2_background">

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/imageBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/startflow_language_image_background"
        android:scaleType="centerCrop"
        android:visibility="gone"/>

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/languageHeader"
            android:layout_width="match_parent"
            android:layout_height="@dimen/app_header_height"
            android:paddingStart="@dimen/app_header_horizontal_padding_start"
            android:paddingEnd="@dimen/app_header_horizontal_padding_end">


            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/languageBack"
                style="@style/AppHeaderBack"
                android:src="@drawable/ic_back_dark"
                android:tint="@color/startflow_language_v2_back_icon"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:visibility="visible"/>

            <TextView
                android:id="@+id/languageTitle"
                style="@style/AppHeaderTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/app_header_title_margin_start"
                android:text="@string/startflow_language_v2_screen_title"
                android:textColor="@color/startflow_language_v2_title"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/languageApply"
                app:layout_constraintStart_toEndOf="@id/languageBack"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_goneMarginStart="0dp"/>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/languageApply"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/roboto_medium"
                android:gravity="center"
                android:minWidth="44dp"
                android:paddingHorizontal="8dp"
                android:textAllCaps="false"
                android:textColor="@color/startflow_language_v2_apply_text"
                android:textSize="@dimen/startflow_language_v2_apply_use_text_size"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="Save"/>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvLanguage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="10dp"
                android:paddingEnd="16dp"
                android:paddingBottom="16dp"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:listitem="@layout/startflow_item_language_group_v2"/>

        </FrameLayout>

        <FrameLayout
            android:id="@+id/layout_ads"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent">

            <com.core.ads.customviews.ads.BannerNativeContainerLayout
                android:id="@+id/layout_banner_native"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:background="@color/startflow_language_v2_ad_background"/>
        </FrameLayout>
    </androidx.appcompat.widget.LinearLayoutCompat>

    <FrameLayout
        android:id="@+id/lnApplyLoading"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:accessibilityLiveRegion="polite"
        android:background="@color/startflow_language_v2_applying_scrim"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        tools:visibility="visible">

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/applyingLanguageIcon"
                android:layout_width="140dp"
                android:layout_height="140dp">

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/start_flow_language_wait"/>
            </FrameLayout>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/applyingLanguageMessage"
                android:layout_width="280dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:fontFamily="@font/roboto_regular"
                android:gravity="center"
                android:lineSpacingExtra="2dp"
                android:text="@string/core_setting_up_language"
                android:textColor="@color/startflow_language_v2_applying_text"
                android:textSize="16sp"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
    </FrameLayout>
</FrameLayout>
